#!/bin/bash
# cib — deploy the Coupa Integration Baseline (CIB) with Docker, credentials from a named source.
#
#   cib configure NAME [--source file|keychain]        create / edit (Enter keeps a value)
#   cib deploy    NAME [--source S] [--yes [--accept-warnings]] [--preflight-only]
#   cib teardown  NAME [--source S] [--yes] [--dry-run]   remove what the last deploy created
#   cib delete    NAME [--source file|keychain]           delete the credential set
#   cib list                                            names of the credential files
#
# Sources (default: file):
#   file       ~/.cib/NAME.env — plain KEY=VALUE lines, mode 0600; edit in any editor, delete with rm.
#              Also works without this script: docker run --rm -it --env-file ~/.cib/NAME.env cib-deploy
#   keychain   macOS Keychain, generic password: service "cib-deploy", account NAME
#   bitwarden  Bitwarden Secure Note named "cib-deploy/NAME" whose notes are the KEY=VALUE lines
#              (read-only: create the note in Bitwarden; `bw` must be logged in)
#
# The values reach the container as environment variables (docker run -e NAME): nothing is stored
# in the image or in a Docker volume. Logs (secrets masked by the container): ~/.cib/logs/.
set -u

DIR="${CIB_HOME:-$HOME/.cib}"
IMAGE="${CIB_IMAGE:-cib-deploy}"
SERVICE=cib-deploy
KEYS=(CIB_ROSSUM_URL CIB_ORG_ID CIB_REGION CIB_USERNAME CIB_PASSWORD CIB_VERSION CIB_COUPA_URL CIB_COUPA_CLIENT_ID CIB_COUPA_CLIENT_SECRET)
LABELS=("Rossum URL, e.g. https://acme.rossum.app" "Rossum organisation ID"
  "Rossum region: prod-eu, prod-eu2, prod-us2, prod-jp (empty = detect)"
  "Rossum admin username (owns the CIB hook tokens)" "Rossum password"
  "CIB version, e.g. v2.0.1 (empty = newest in the image)" "Coupa URL, e.g. https://acme-test.coupahost.com"
  "Coupa OAuth client ID" "Coupa OAuth client secret")

die() { echo "cib: $*" >&2; exit 1; }
usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
is_secret() { case "$1" in CIB_PASSWORD | CIB_COUPA_CLIENT_ID | CIB_COUPA_CLIENT_SECRET) return 0 ;; esac; return 1; }

blob() {  # the stored KEY=VALUE lines, from the chosen source
  case "$SOURCE" in
    file) [ -f "$DIR/$NAME.env" ] && cat "$DIR/$NAME.env" ;;
    keychain) security find-generic-password -s "$SERVICE" -a "$NAME" -w 2>/dev/null | base64 -d ;;
    bitwarden) bw get notes "$SERVICE/$NAME" ;;
  esac
}

load() {  # blob -> shell variables; unknown keys are an error (typos must not pass silently)
  local line k
  for k in "${KEYS[@]}"; do printf -v "$k" '%s' ""; done
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in '' | '#'*) continue ;; esac
    k="${line%%=*}"
    case " ${KEYS[*]} " in *" $k "*) printf -v "$k" '%s' "${line#*=}" ;; *) die "unknown key '$k' in $SOURCE '$NAME'" ;; esac
  done
}

render() { local k; for k in "${KEYS[@]}"; do printf '%s=%s\n' "$k" "${!k}"; done; }

hint() {  # what the prompt shows for the stored value
  local v="${!1}"
  [ -z "$v" ] && return
  if [ "$1" = CIB_PASSWORD ]; then printf '****'
  elif is_secret "$1"; then [ ${#v} -gt 8 ] && printf '****%s' "${v: -4}" || printf '****'
  else printf '%s' "$v"; fi
}

save() {
  case "$SOURCE" in
    file)
      mkdir -p "$DIR" && chmod 700 "$DIR"
      (umask 077 && render >"$DIR/$NAME.env.tmp") && mv "$DIR/$NAME.env.tmp" "$DIR/$NAME.env"
      echo "Saved $DIR/$NAME.env" ;;
    keychain)
      # Through `security -i` on stdin, so the secret is never a process argument (visible in ps).
      printf 'add-generic-password -U -s %s -a %s -l %s -w %s\n' "$SERVICE" "$NAME" "$SERVICE/$NAME" \
        "$(render | base64 | tr -d '\n')" | security -i >/dev/null || die "could not write to the Keychain"
      echo "Saved in the Keychain: service $SERVICE, account $NAME" ;;
    bitwarden)
      die "bitwarden is read-only here: create a Secure Note named '$SERVICE/$NAME' with these lines:
$(for k in "${KEYS[@]}"; do echo "  $k=..."; done)" ;;
  esac
}

configure() {
  [ "$SOURCE" = bitwarden ] && save
  load < <(blob)
  echo "Credential set '$NAME' ($SOURCE). Enter keeps the value in [brackets]."
  local i k new
  for i in "${!KEYS[@]}"; do
    k="${KEYS[$i]}"
    if is_secret "$k"; then read -r -s -p "${LABELS[$i]} [$(hint "$k")]: " new; echo
    else read -r -p "${LABELS[$i]} [$(hint "$k")]: " new; fi
    case "$new" in *$'\n'* | *$'\r'*) die "a value cannot contain a line break" ;; esac
    [ -n "$new" ] && printf -v "$k" '%s' "$new"
  done
  save
}

deploy() {
  local data k
  data="$(blob)" || die "could not read '$NAME' from $SOURCE"
  [ -n "$data" ] || die "no credential set '$NAME' in $SOURCE (create it: cib configure $NAME --source $SOURCE)"
  load <<<"$data"
  local env=()
  for k in "${KEYS[@]}"; do export "$k"; env+=(-e "$k"); done  # -e NAME: the value never is an argument
  local tty=(-i) log
  [ -t 0 ] && [ -t 1 ] && tty=(-it)
  umask 077  # logs hold no secrets (masked), but usernames and org details
  mkdir -p "$DIR/logs" && chmod 700 "$DIR" "$DIR/logs"
  log="$DIR/logs/$(date -u +%Y%m%dT%H%M%SZ)-$NAME.log"
  docker run --rm "${tty[@]}" "${env[@]}" "$IMAGE" "$@" 2>&1 | tee "$log"
  local rc=${PIPESTATUS[0]}
  echo "Log: $log"
  return "$rc"
}

remove() {
  case "$SOURCE" in
    file) rm -i "$DIR/$NAME.env" ;;
    keychain) security delete-generic-password -s "$SERVICE" -a "$NAME" >/dev/null && echo "Deleted from the Keychain: $NAME" ;;
    bitwarden) die "delete the Secure Note '$SERVICE/$NAME' in Bitwarden" ;;
  esac
}

[ $# -ge 1 ] || usage
CMD="$1"; shift
if [ "$CMD" = list ]; then ls "$DIR"/*.env 2>/dev/null | sed 's#.*/##; s#\.env$##'; exit 0; fi
[ $# -ge 1 ] && [ "${1#-}" = "$1" ] || { echo "cib: every credential set has a name: cib $CMD NAME" >&2; usage; }
NAME="$1"; shift
[[ "$NAME" =~ ^[A-Za-z0-9._-]+$ ]] || die "a name may contain only letters, digits, '.', '_' and '-'"
SOURCE=file
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --source) SOURCE="${2:-}"; shift 2 || usage ;;
    --source=*) SOURCE="${1#*=}"; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
case "$SOURCE" in file | keychain | bitwarden) ;; *) die "unknown source '$SOURCE' (file, keychain, bitwarden)" ;; esac
case "$CMD" in
  configure) configure ;;
  deploy) deploy ${ARGS[@]+"${ARGS[@]}"} ;;
  teardown) deploy --teardown ${ARGS[@]+"${ARGS[@]}"} ;;
  delete) remove ;;
  *) usage ;;
esac
